CODE_GENOME_DATABASE_URL=postgresql+psycopg://code_genome:code_genome@localhost:5432/code_genome
CODE_GENOME_REDIS_URL=redis://localhost:6379/0
CODE_GENOME_JOB_BACKEND=inline
CODE_GENOME_JOB_DELAY_SECONDS=1
CODE_GENOME_BOOTSTRAP_DEMO=true
CODE_GENOME_CORS_ORIGINS=http://localhost:3000
CODE_GENOME_CLONE_DEPTH=200
CODE_GENOME_CLONE_TIMEOUT_SECONDS=120
CODE_GENOME_MAX_SOURCE_FILES=10000
CODE_GENOME_MAX_SOURCE_FILE_BYTES=1000000
CODE_GENOME_MAX_SOURCE_TOTAL_BYTES=100000000
CODE_GENOME_MAX_MANIFEST_FILES=100000
CODE_GENOME_MAX_HISTORY_COMMITS=200
CODE_GENOME_MIRROR_ROOT=/tmp/code-genome-mirrors
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
CODE_GENOME_CREDENTIAL_ENCRYPTION_KEY=
CODE_GENOME_CREDENTIAL_KEY_VERSION=local-v1
CODE_GENOME_ENVIRONMENT=development
CODE_GENOME_AUTH_MODE=development
# Production OIDC: signed JWTs must include exp, iat, iss, aud, and sub.
CODE_GENOME_OIDC_ISSUER=
CODE_GENOME_OIDC_AUDIENCE=
CODE_GENOME_OIDC_JWKS_URL=
CODE_GENOME_RETENTION_DAYS=365
CODE_GENOME_RATE_LIMIT_PER_MINUTE=120
CODE_GENOME_MAX_REQUEST_BYTES=1000000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WORKSPACE_ID=ws_demo
NEXT_PUBLIC_USER_ID=usr_demo

# Optional: enhance evidence-backed repository answers with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
